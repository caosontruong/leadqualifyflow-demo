      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>LeadQualifyFlow — Ops Dashboard</title>\n<style>\n  :root { color-scheme: light dark; }\n  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; margin: 0; padding: 24px; background: #0f1115; color: #e6e6e6; }\n  h1 { font-size: 20px; margin-bottom: 4px; }\n  .subtitle { color: #9aa0a6; font-size: 13px; margin-bottom: 24px; }\n  .card { background: #1a1d24; border: 1px solid #2a2e37; border-radius: 10px; padding: 16px; margin-bottom: 20px; }\n  .card h2 { margin: 0 0 12px; font-size: 15px; color: #9aa0a6; text-transform: uppercase; letter-spacing: 0.04em; }\n  table { width: 100%; border-collapse: collapse; font-size: 14px; }\n  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #2a2e37; }\n  th { color: #9aa0a6; font-weight: 500; font-size: 12px; text-transform: uppercase; }\n  .grade { padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; }\n  .grade-hot { background: #3a1a1a; color: #ff6b6b; }\n  .grade-warm { background: #3a2f14; color: #ffb545; }\n  .grade-cold { background: #16232e; color: #6fb8ff; }\n  .score { font-variant-numeric: tabular-nums; font-weight: 600; }\n  .cfg-row { display: flex; gap: 24px; margin-bottom: 12px; }\n  .cfg-box { background: #12141a; border-radius: 8px; padding: 12px 16px; flex: 1; }\n  .cfg-box .label { font-size: 12px; color: #9aa0a6; }\n  .cfg-box .value { font-size: 22px; font-weight: 700; margin-top: 2px; }\n  pre { background: #0b0c0f; padding: 12px; border-radius: 8px; overflow-x: auto; font-size: 12px; line-height: 1.5; max-height: 260px; }\n  .empty { color: #6b7078; font-size: 13px; padding: 12px 0; }\n  .readonly-note { font-size: 12px; color: #6b7078; margin-top: 20px; }\n  .err { color: #ff6b6b; font-size: 13px; }\n</style>\n</head>\n<body>\n  <h1>LeadQualifyFlow — Ops Dashboard</h1>\n  <div class=\"subtitle\">Read-only (AC-25) — top hot leads &amp; current scoring config. No write/edit capability.</div>\n\n  <div class=\"card\">\n    <h2>Top Leads (by Lead Score)</h2>\n    <div id=\"leads-container\"><div class=\"empty\">Loading...</div></div>\n  </div>\n\n  <div class=\"card\">\n    <h2>Current Scoring Config</h2>\n    <div id=\"config-container\"><div class=\"empty\">Loading...</div></div>\n  </div>\n\n  <div class=\"readonly-note\">Auto-refreshes every 15 seconds. Data source: Redis (ranking) + Postgres (lead details) + n8n workflow API (live scoring config).</div>\n\n<script>\nasync function loadLeads() {\n  const el = document.getElementById('leads-container');\n  try {\n    const res = await fetch('/webhook/get-top-leads', {\n      method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({limit: 10})\n    });\n    const data = await res.json();\n    if (!data.topLeads || data.topLeads.length === 0) {\n      el.innerHTML = '<div class=\"empty\">No leads scored yet.</div>';\n      return;\n    }\n    let rows = data.topLeads.map(l => `\n      <tr>\n        <td>${l.name || '(no name)'}</td>\n        <td>${l.email || '—'}</td>\n        <td>${l.source || '—'}</td>\n        <td><span class=\"grade grade-${l.leadGrade || 'cold'}\">${(l.leadGrade || '?').toUpperCase()}</span></td>\n        <td class=\"score\">${l.score}</td>\n      </tr>`).join('');\n    el.innerHTML = `<table><thead><tr><th>Name</th><th>Email</th><th>Source</th><th>Grade</th><th>Score</th></tr></thead><tbody>${rows}</tbody></table>\n      <div class=\"readonly-note\">${data.totalLeadsRanked} total leads scored in Redis.</div>`;\n  } catch (e) {\n    el.innerHTML = '<div class=\"err\">Error loading top leads: ' + e.message + '</div>';\n  }\n}\n\nasync function loadConfig() {\n  const el = document.getElementById('config-container');\n  try {\n    const res = await fetch('/webhook/dashboard/scoring-config');\n    const data = await res.json();\n    const t = data.thresholds || {};\n    el.innerHTML = `\n      <div class=\"cfg-row\">\n        <div class=\"cfg-box\"><div class=\"label\">HOT Threshold</div><div class=\"value\">&ge; ${t.hot ?? '—'}</div></div>\n        <div class=\"cfg-box\"><div class=\"label\">WARM Threshold</div><div class=\"value\">&ge; ${t.warm ?? '—'}</div></div>\n        <div class=\"cfg-box\"><div class=\"label\">Score Version</div><div class=\"value\">${data.scoreVersion ?? '—'}</div></div>\n      </div>\n      <div class=\"label\" style=\"margin-bottom:6px; color:#9aa0a6; font-size:12px;\">Source of node \"Scoring Config\" (live, read directly via n8n API):</div>\n      <pre>${(data.rawSourceCode || '').replace(/</g, '&lt;')}</pre>`;\n  } catch (e) {\n    el.innerHTML = '<div class=\"err\">Error loading scoring config: ' + e.message + '</div>';\n  }\n}\n\nfunction refreshAll() { loadLeads(); loadConfig(); }\nrefreshAll();\nsetInterval(refreshAll, 15000);\n</script>\n</body>\n</html>",
