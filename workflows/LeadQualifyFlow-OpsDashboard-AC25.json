        "jsCode": "const nodes = $json.nodes || [];\nconst cfgNode = nodes.find(n => n.name === 'Scoring Config');\nconst src = cfgNode ? cfgNode.parameters.jsCode : '';\nconst hotMatch = src.match(/hot:\\s*(\\d+)/);\nconst warmMatch = src.match(/warm:\\s*(\\d+)/);\nconst versionMatch = src.match(/score_version:\\s*'([^']+)'/);\nreturn { json: {\n  thresholds: { hot: hotMatch ? Number(hotMatch[1]) : null, warm: warmMatch ? Number(warmMatch[1]) : null },\n  scoreVersion: versionMatch ? versionMatch[1] : null,\n  rawSourceCode: src\n} };"
