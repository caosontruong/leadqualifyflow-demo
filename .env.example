# LeadQualifyFlow demo: copy to .env and fill in. Never commit .env.
# The values below match the "core" profile: Airtable + Slack only.

# --- Core (required) ---
# Airtable acts as a mock CRM: every lead is written as a record.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads
# Slack Incoming Webhook URL: hot leads are announced here.
SLACK_WEBHOOK_URL=
# Anthropic API key: scripts/setup-n8n.py stores it in n8n as a credential (the AI model that classifies leads).
ANTHROPIC_API_KEY=
# Host port of n8n (http://127.0.0.1:<port>). Change it if 5679 is already in use.
N8N_HOST_PORT=5679
# Time zone for n8n and for the Received At timestamp (IANA name, e.g. Asia/Ho_Chi_Minh, Europe/Berlin, America/New_York).
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
# Path of the intake webhook (the URL is http://127.0.0.1:5679/webhook/<path>).
N8N_WEBHOOK_PATH=lead-intake

# n8n API key: create it in the n8n UI (Settings -> n8n API). Used by the Ops Dashboard
# workflow and by scripts/seed-demo.sh and scripts/measure-latency.sh. Never paste it into chat or logs.
N8N_API_KEY=

# Redis TTLs (seconds) for the duplicate-delivery guard and the AI result cache.
REDIS_DEDUP_TTL_SECONDS=300
REDIS_AI_CACHE_TTL_SECONDS=86400

# --- Channel and backend switches ---
# An empty value means ENABLED (the workflow default). "false" disables one channel.
# These are set to the core profile: Airtable (always on) + Slack.
ENABLE_SLACK_NOTIFY=true
ENABLE_DISCORD_NOTIFY=false
ENABLE_TELEGRAM_NOTIFY=false
ENABLE_NTFY_NOTIFY=false
ENABLE_EMAIL_NOTIFY=false
ENABLE_NOTION_NOTIFY=false
ENABLE_WHATSAPP_NOTIFY=false
ENABLE_POSTGRES_WRITE=false
ENABLE_GOOGLE_SHEETS_WRITE=false
ENABLE_BASEROW_WRITE=false
ENABLE_SUPABASE_WRITE=false

# --- Optional: fill in only for the channels you enable above ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
NTFY_TOPIC=
GMAIL_ADDRESS=
NOTIFY_EMAIL_LIST=
NOTION_TOKEN=
NOTION_DATABASE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_PHONE_NUMBER=
# Facebook Lead Ads / Messenger adapter (webhook verification handshake)
FB_WEBHOOK_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=
